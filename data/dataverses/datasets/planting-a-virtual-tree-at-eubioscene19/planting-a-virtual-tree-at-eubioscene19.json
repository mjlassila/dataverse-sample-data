{"datasetVersion":{"versionNumber":5,"versionMinorNumber":2,"versionState":"RELEASED","distributionDate":"2019","productionDate":"Production Date","lastUpdateTime":"2016-11-17T18:31:33Z","releaseTime":"2016-11-17T18:31:33Z","createTime":"2016-11-17T17:50:28Z","metadataBlocks":{"citation":{"displayName":"Citation Metadata","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Planting a virtual tree at EUBioScene19"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Filipe Da Graca Gama"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"demo-contact-mail-nomail@tuni.fi"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Finland’s tallest tree was virtually planted at the European Bioeconomy Scene 2019 (EUBioScene19) on Wednesday, 9 July 2019. The demo was prepared in collaboration with CIVIT (by Filipe Gama, Jani Mäkinen and Olli Suominen) for the Natural Resources Institute Finland (LUKE). Finland’s tallest, almost 47 meters tall tree, is located in Punkaharju. The tree was first scanned, and then a mesh for HoloLens was created.\r\n\r\nThe demo was successfully shown at the European Bioeconomy Scene 2019 conference."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"topicClassification","multiple":true,"typeClass":"compound","value":[{"topicClassValue":{"typeName":"topicClassValue","multiple":false,"typeClass":"primitive","value":""}}]},{"typeName":"publication","multiple":true,"typeClass":"compound","value":[{"publicationCitation":{"typeName":"publicationCitation","multiple":false,"typeClass":"primitive","value":""}}]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":""},{"typeName":"distributor","multiple":true,"typeClass":"compound","value":[{"distributorName":{"typeName":"distributorName","multiple":false,"typeClass":"primitive","value":"Tampere University"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2019"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2019"}]}},"citation":"Filipe Da Graca Gama et al, 2019,  Planting a virtual tree at EUBioScene19, https:\/\/doi.org\/"}}